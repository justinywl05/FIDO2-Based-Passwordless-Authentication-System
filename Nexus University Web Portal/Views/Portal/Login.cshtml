@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Nexus Portal</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/portal.css" asp-append-version="true" />
    <style>
        /* QR MFA specific styles */
        .login-stage-container {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 40px;
            width: 100%;
            max-width: 1000px;
        }

        .phone-simulator {
            width: 300px;
            height: 600px;
            border-radius: 40px;
            border: 12px solid #1f2937;
            background: #0f172a;
            box-shadow: 0 25px 50px rgba(0,0,0,0.5);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            position: relative;
            transform: translateX(100px);
            opacity: 0;
            pointer-events: none;
            transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .phone-simulator.visible {
            transform: translateX(0);
            opacity: 1;
            pointer-events: auto;
        }

        .phone-screen {
            padding: 24px 16px;
            display: flex;
            flex-direction: column;
            height: 100%;
            color: #f3f4f6;
        }

        .phone-notch {
            width: 120px;
            height: 25px;
            background: #1f2937;
            align-self: center;
            border-bottom-left-radius: 16px;
            border-bottom-right-radius: 16px;
            position: absolute;
            top: 0;
            z-index: 10;
        }

        .scanner-viewport {
            flex-grow: 1;
            border: 2px dashed var(--accent-color);
            border-radius: 16px;
            background: rgba(var(--accent-rgb), 0.05);
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow: hidden;
            margin: 20px 0;
        }

        .scanner-laser {
            position: absolute;
            left: 0;
            width: 100%;
            height: 3px;
            background: #ef4444;
            box-shadow: 0 0 10px #ef4444;
            animation: scanning 2s infinite linear;
        }

        .qr-placeholder {
            width: 200px;
            height: 200px;
            border-radius: 12px;
            background: #ffffff;
            padding: 16px;
            margin: 20px auto;
            box-shadow: 0 0 20px rgba(255,255,255,0.05);
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
        }

        .progress-timer-bar {
            width: 100%;
            height: 6px;
            background: var(--border-color);
            border-radius: 3px;
            overflow: hidden;
            margin-top: 16px;
        }

        .progress-timer-fill {
            height: 100%;
            background: var(--accent-color);
            width: 100%;
            transition: width 1s linear;
        }

        @@keyframes scanning {
            0% { top: 0%; }
            50% { top: 100%; }
            100% { top: 0%; }
        }

        @@keyframes biometricPulse {
            0% { transform: scale(1); opacity: 0.8; }
            100% { transform: scale(1.3); opacity: 0; }
        }

        @@keyframes blink {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.4; }
        }

        /* Tab button styling */
        .tab-btn {
            flex: 1;
            padding: 10px;
            border-radius: 8px;
            border: none;
            background: none;
            color: var(--text-secondary);
            font-size: 0.85rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }
        .tab-btn.active {
            background: var(--accent-color) !important;
            color: #ffffff !important;
            box-shadow: 0 4px 12px rgba(var(--accent-rgb), 0.3);
        }
        .tab-btn:hover:not(.active) {
            background: rgba(255, 255, 255, 0.05);
            color: var(--text-primary);
        }

        @@media (max-width: 900px) {
            .login-stage-container {
                flex-direction: column;
                gap: 24px;
                max-width: 520px;
            }

            .phone-simulator {
                width: min(300px, 82vw);
                height: 560px;
                transform: translateY(32px);
            }

            .phone-simulator.visible {
                transform: translateY(0);
            }
        }

        @@media (max-width: 640px) {
            .login-stage-container {
                gap: 18px;
            }

            .phone-simulator {
                width: min(280px, 88vw);
                height: 520px;
                border-width: 10px;
                border-radius: 34px;
            }

            .phone-screen {
                padding: 22px 14px;
            }

            .qr-placeholder {
                width: 170px;
                height: 170px;
                padding: 12px;
            }
        }

        @@media (max-width: 420px) {
            .phone-simulator {
                height: 480px;
            }

            .scanner-viewport {
                margin: 14px 0;
            }
        }
    </style>
</head>
<body class="login-body">
    <!-- Floating background blobs -->
    <div class="bg-blobs">
        <div class="blob blob-1" style="opacity: 0.25; filter: blur(100px);"></div>
        <div class="blob blob-2" style="opacity: 0.25; filter: blur(100px);"></div>
    </div>

    <!-- Layout container that holds desktop card + phone simulator -->
    <div class="login-stage-container">
        
        <!-- Login Card -->
        <div class="login-card glass-panel" id="desktop-login-card">
            <div class="login-logo">
                <i class="fas fa-graduation-cap"></i>
                <span class="accent-gradient-text">NEXUS</span>
            </div>
            <p class="login-subtitle">Identity & Access Management Console</p>

            @if (ViewBag.ExpiredMessage != null)
            {
                <div style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 12px; padding: 12px 16px; font-size: 0.85rem; color: #ef4444; margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
                    <i class="fas fa-exclamation-triangle"></i>
                    <span>@ViewBag.ExpiredMessage</span>
                </div>
            }

            @if (ViewBag.ErrorMessage != null)
            {
                <div style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 12px; padding: 12px 16px; font-size: 0.85rem; color: #ef4444; margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
                    <i class="fas fa-exclamation-circle"></i>
                    <span>@ViewBag.ErrorMessage</span>
                </div>
            }

            <!-- STAGE 1: FIDO2 Passwordless Login -->
            <div id="login-stage-1">
                <!-- Form: Passwordless WebAuthn / QR authentication -->
                <form id="credentials-form" onsubmit="event.preventDefault(); triggerFido2Auth();">
                    <div class="form-group" style="margin-bottom: 24px;">
                        <label class="form-label" for="Email">Email Address or Username</label>
                        <div style="position: relative;">
                            <i class="fas fa-user" style="position: absolute; left: 16px; top: 50%; transform: translateY(-50%); color: var(--text-muted);"></i>
                            <input class="form-input" id="Email" name="email" type="text" placeholder="student@portal.edu or student" required style="padding-left: 48px;" />
                        </div>
                    </div>

                    <button type="submit" class="btn-portal" style="width: 100%; padding: 14px; margin-bottom: 16px;">
                        <i class="fas fa-fingerprint" style="margin-right: 8px;"></i> Sign In with Passkey (FIDO2)
                    </button>
                    
                    <div style="text-align: center; margin-top: 16px;">
                        <a href="#" onclick="triggerQrAuth(event)" style="font-size: 0.85rem; color: var(--accent-color); text-decoration: none; font-weight: 600; display: inline-flex; align-items: center; gap: 6px;">
                            <i class="fas fa-qrcode"></i> Use QR-code Mobile Authenticator
                        </a>
                    </div>

                </form>


            </div>

            <!-- STAGE 2: Time-Limited QR-Based MFA -->
            <div id="login-stage-2" style="display: none; text-align: center;">
                <h3 style="font-size: 1.125rem; font-weight: 700; margin-bottom: 8px;">Verify Your Identity</h3>
                <p style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 20px;">Use your registered authentication mobile device to scan this time-limited QR-Code.</p>
                
                <!-- Mock QR Code -->
                <div class="qr-placeholder" id="qr-element">
                    <!-- Dynamic simulated QR code lines -->
                    <svg width="150" height="150" viewBox="0 0 29 29" fill="none" stroke="#000000" stroke-width="1" style="shape-rendering: crispedges;">
                        <!-- Mock QR SVG matrix -->
                        <path d="M0 0h7v7H0zm22 0h7v7h-7zM0 22h7v7H0z" fill="#000" />
                        <path d="M2 2h3v3H2zm22 0h3v3h-3zM2 24h3v3H2z" fill="#fff" />
                        <path d="M9 1h1v3H9zm4 1h3v1h-3zm5 2h2v2h-2zm-5 4h1v1h-1zm10 2h3v1h-3zm-9 3h2v2h-2zm5 4h3v1h-3zm-10 6h1v3h-1zm5-2h2v3h-2z" fill="#000" />
                        <!-- QR code center security lock visual -->
                        <rect x="11" y="11" width="7" height="7" rx="1.5" fill="var(--accent-color)" />
                    </svg>
                </div>

                <div style="font-size: 0.75rem; color: var(--text-secondary); margin-top: 8px;">
                    Session Key: <code id="session-key-lbl">MFA-SESS-8291A</code>
                </div>

                <!-- 60s countdown progress bar -->
                <div class="progress-timer-bar">
                    <div class="progress-timer-fill" id="timer-bar-fill"></div>
                </div>
                <div style="font-size: 0.8rem; font-weight: 600; color: var(--text-secondary); margin-top: 8px;" id="countdown-lbl">
                    Expires in 60 seconds
                </div>

                <!-- Back button to reset credentials -->
                <button class="btn-portal-secondary" style="margin-top: 24px; padding: 8px 16px; font-size: 0.8rem;" onclick="resetLoginStage()">
                    <i class="fas fa-chevron-left"></i> Back to Login Options
                </button>
            </div>
        </div>

        <!-- Phone Mobile Simulator Widget -->
        <div class="phone-simulator" id="mobile-simulator">
            <div class="phone-notch"></div>
            <div class="phone-screen">
                <!-- Status bar -->
                <div style="display: flex; justify-content: space-between; font-size: 0.7rem; color: #9ca3af; margin-bottom: 20px;">
                    <span>18:15</span>
                    <div style="display: flex; gap: 4px;">
                        <i class="fas fa-signal"></i>
                        <i class="fas fa-wifi"></i>
                        <i class="fas fa-battery-three-quarters"></i>
                    </div>
                </div>

                <h4 style="font-size: 0.95rem; font-weight: 800; text-align: center; color: var(--accent-color);"><i class="fas fa-shield-halved"></i> NEXUS AUTHENTICATOR</h4>
                <p style="font-size: 0.7rem; color: #9ca3af; text-align: center; margin-top: 4px;">Trusted Primary Device: <strong>iPhone 15 Pro</strong></p>

                <!-- Phone Camera Simulator Area -->
                <div class="scanner-viewport">
                    <div class="scanner-laser"></div>
                    <div style="text-align: center; z-index: 5; padding: 12px;">
                        <i class="fas fa-qrcode" style="font-size: 3rem; color: var(--accent-color); opacity: 0.35; margin-bottom: 12px; display: block;"></i>
                        <span style="font-size: 0.75rem; font-weight: 600; color: #d1d5db;" id="scanner-instruction-lbl">Align QR Code within target</span>
                    </div>
                </div>

                <div style="margin-top: auto; display: flex; flex-direction: column; gap: 10px;">
                    <button class="btn-portal" style="padding: 10px; font-size: 0.8rem;" id="scan-action-btn" onclick="simulateQrScan()">
                        <i class="fas fa-camera"></i> Scan QR Code on Screen
                    </button>
                    <button class="btn-portal-secondary" style="padding: 8px; font-size: 0.75rem; border-color: rgba(255,255,255,0.15);" onclick="toggleSimulator(false)">
                        Cancel Scan
                    </button>
                </div>
            </div>
        </div>

    </div>

    <!-- Mock Native Browser WebAuthn Biometric Overlay -->
    <div id="webauthn-modal" class="portal-modal">
        <div class="glass-panel" style="max-width: 480px; width: 90%; padding: 32px; border-radius: 20px; box-shadow: 0 20px 50px rgba(0,0,0,0.5); text-align: center; position: relative;">
            <!-- Origin Binding Badge -->
            <div style="display: inline-flex; align-items: center; gap: 6px; background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.3); border-radius: 20px; padding: 4px 12px; margin-bottom: 20px; font-size: 0.75rem; color: #10b981; font-weight: 600;">
                <i class="fas fa-shield-halved"></i> Origin Bound: <span id="webauthn-origin">localhost</span>
            </div>

            <h3 style="font-size: 1.25rem; font-weight: 800; margin-bottom: 8px;">Verify Your Identity</h3>
            <p style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 24px;">Touch your fingerprint sensor or insert your security key to sign in to <strong style="color: var(--text-primary);">localhost</strong></p>

            <!-- Biometric Scan Ring -->
            <div class="biometric-ring-container" style="position: relative; width: 120px; height: 120px; margin: 0 auto 24px; display: flex; align-items: center; justify-content: center;">
                <div class="biometric-pulse" id="webauthn-pulse" style="position: absolute; inset: -10px; border-radius: 50%; border: 2px solid var(--accent-color); opacity: 0; animation: biometricPulse 2s infinite;"></div>
                <div style="width: 100px; height: 100px; border-radius: 50%; background: rgba(var(--accent-rgb), 0.1); border: 2px solid var(--accent-color); display: flex; align-items: center; justify-content: center; font-size: 3rem; color: var(--accent-color); cursor: pointer;" onclick="startMockFingerprintScan()">
                    <i class="fas fa-fingerprint" id="fingerprint-icon"></i>
                </div>
            </div>

            <!-- Interactive simulation status -->
            <div id="webauthn-status" style="font-size: 0.85rem; font-weight: 600; color: var(--text-secondary); margin-bottom: 24px; min-height: 20px;">
                Waiting for biometric input...
            </div>

            <!-- Cryptographic Console Panel -->
            <div style="background: rgba(0,0,0,0.3); border: 1px solid var(--border-color); border-radius: 12px; padding: 16px; text-align: left; font-family: monospace; font-size: 0.75rem; max-height: 180px; overflow-y: auto; margin-bottom: 24px; line-height: 1.4;">
                <div style="color: #6b7280; border-bottom: 1px solid rgba(255,255,255,0.05); padding-bottom: 4px; margin-bottom: 6px; font-weight: 700; display: flex; justify-content: space-between;">
                    <span>FIDO2 / WEBAUTHN CONSOLE</span>
                    <span style="color: #10b981; animation: blink 1s infinite;">● LIVE</span>
                </div>
                <div id="crypto-log">
                    <div style="color: #6b7280;">&gt; Console initialised. Ready for ceremony...</div>
                </div>
            </div>

            <div style="display: flex; gap: 12px; justify-content: flex-end;">
                <button class="btn-portal-secondary" style="padding: 8px 16px; font-size: 0.8rem;" onclick="closeWebAuthnModal()">Cancel</button>
                <button class="btn-portal" style="padding: 8px 16px; font-size: 0.8rem;" id="webauthn-scan-btn" onclick="startMockFingerprintScan()">Touch Sensor</button>
            </div>
        </div>
    </div>

    <script src="~/js/portal.js" asp-append-version="true"></script>
    <script>
        let countdownInterval = null;
        let countdownSeconds = 60;
        let cachedEmail = "";
        let authTypeSelected = "";





        function appendLog(text, color = "#9ca3af") {
            const consoleEl = document.getElementById("crypto-log");
            if (consoleEl) {
                const line = document.createElement("div");
                line.style.color = color;
                line.style.marginBottom = "4px";
                line.innerHTML = text;
                consoleEl.appendChild(line);
                consoleEl.scrollTop = consoleEl.scrollHeight;
            }
        }

        function coerceToArrayBuffer(thing) {
            if (typeof thing === 'string') {
                thing = thing.replace(/-/g, '+').replace(/_/g, '/');
                const str = window.atob(thing);
                const bytes = new Uint8Array(str.length);
                for (let i = 0; i < str.length; i++) bytes[i] = str.charCodeAt(i);
                return bytes.buffer;
            }
            if (thing instanceof Uint8Array) return thing.buffer;
            return thing;
        }

        function coerceToBase64Url(thing) {
            if (thing instanceof ArrayBuffer) thing = new Uint8Array(thing);
            if (thing instanceof Uint8Array) {
                let str = '';
                for (let i = 0; i < thing.byteLength; i++) str += String.fromCharCode(thing[i]);
                thing = window.btoa(str);
            }
            return thing.replace(/\+/g, '-').replace(/\//g, '_').replace(/=*$/g, '');
        }

        async function triggerFido2Auth() {
            const emailVal = document.getElementById("Email").value.trim();
            if (!emailVal) {
                showToast("Please enter your email or username first.", "warning");
                return;
            }
            cachedEmail = emailVal;
            authTypeSelected = "Passkey";

            const btn = document.querySelector(".btn-portal") || document.getElementById("login-btn");
            const originalBtnText = btn ? btn.textContent : "Login";
            if (btn) btn.textContent = "Waiting for passkey...";

            try {
                // 1. Get options
                const optionsRes = await fetch('/api/auth/login/options', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: emailVal })
                });
                const optionsData = await optionsRes.json();
                
                if (!optionsRes.ok || optionsData.status !== 'ok') {
                    showToast(optionsData.errorMessage || "Failed to get login options", "error");
                    if (btn) btn.innerHTML = '<i class="fas fa-fingerprint"></i> Sign In with Passkey';
                    return;
                }

                if (!optionsData.options) {
                    if (btn) btn.textContent = "Verifying dev bypass...";
                    const verifyRes = await fetch('/api/auth/login/verify', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            email: emailVal,
                            assertionResponse: {}
                        })
                    });
                    const verifyData = await verifyRes.json();
                    if (verifyData.success) {
                        showToast("Bypass Successful!", "success");
                        submitFinalLogin();
                    } else {
                        showToast(verifyData.message, "error");
                        if (btn) btn.innerHTML = '<i class="fas fa-fingerprint"></i> Sign In with Passkey';
                    }
                    return;
                }

                // 2. Decode options for navigator
                const publicKey = optionsData.options;
                publicKey.challenge = coerceToArrayBuffer(publicKey.challenge);
                if (publicKey.allowCredentials) {
                    publicKey.allowCredentials.forEach(c => {
                        c.id = coerceToArrayBuffer(c.id);
                    });
                }

                // 3. Prompt user
                const assertion = await navigator.credentials.get({ publicKey });

                // 4. Encode assertion for server
                const assertionResponse = {
                    id: assertion.id,
                    rawId: coerceToBase64Url(assertion.rawId),
                    type: assertion.type,
                    response: {
                        authenticatorData: coerceToBase64Url(assertion.response.authenticatorData),
                        clientDataJSON: coerceToBase64Url(assertion.response.clientDataJSON),
                        signature: coerceToBase64Url(assertion.response.signature),
                        userHandle: assertion.response.userHandle ? coerceToBase64Url(assertion.response.userHandle) : null
                    }
                };

                if (btn) btn.textContent = "Verifying...";

                // 5. Verify on server
                const verifyRes = await fetch('/api/auth/login/verify', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        email: emailVal,
                        assertionResponse: assertionResponse
                    })
                });

                const verifyData = await verifyRes.json();

                if (verifyData.success) {
                    showToast("Login successful!", "success");
                    submitFinalLogin();
                } else {
                    showToast(verifyData.message || "Login failed.", "error");
                    if (btn) btn.innerHTML = '<i class="fas fa-fingerprint"></i> Sign In with Passkey';
                }

            } catch (err) {
                console.error("WebAuthn error", err);
                showToast("Authentication cancelled or failed: " + err.message, "error");

                // Report failure to backend for analytics
                fetch('/api/auth/login/report-failure', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: emailVal, errorMessage: err.message })
                }).catch(e => console.error("Failed to report error", e));

                if (btn) btn.innerHTML = '<i class="fas fa-fingerprint"></i> Sign In with Passkey';
            }
        }

        function closeWebAuthnModal() {
            // Deprecated mock UI modal function
        }

        function startMockFingerprintScan() {
            // Deprecated mock UI modal function
        }

        async function triggerQrAuth(e) {
            if (e) e.preventDefault();
            const emailVal = document.getElementById("Email").value.trim();
            if (!emailVal) {
                showToast("Please enter your email or username first.", "warning");
                return;
            }
            cachedEmail = emailVal;
            authTypeSelected = "QR-Scan";

            const btn = document.querySelector(".btn-portal") || document.getElementById("login-btn");
            const originalBtnText = btn ? btn.textContent : "Login";
            if (btn) btn.textContent = "Waiting for cross-device authentication...";

            try {
                // 1. Get cross-device options from the dedicated CDA endpoint
                const optionsRes = await fetch('/api/auth/login/options-cda', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: emailVal })
                });
                const optionsData = await optionsRes.json();
                
                if (!optionsRes.ok || optionsData.status !== 'ok') {
                    showToast(optionsData.errorMessage || "Failed to get login options", "error");
                    if (btn) btn.innerHTML = '<i class="fas fa-fingerprint"></i> Sign In with Passkey';
                    return;
                }

                if (!optionsData.options) {
                    showToast("Cross-device login is not supported for development bypass accounts.", "warning");
                    if (btn) btn.innerHTML = '<i class="fas fa-fingerprint"></i> Sign In with Passkey';
                    return;
                }

                // 2. Decode options for navigator
                const publicKey = optionsData.options;
                publicKey.challenge = coerceToArrayBuffer(publicKey.challenge);

                // Critical: tag every credential with hybrid transport so the browser shows the QR/Bluetooth picker
                if (publicKey.allowCredentials && publicKey.allowCredentials.length > 0) {
                    publicKey.allowCredentials = publicKey.allowCredentials.map(c => ({
                        ...c,
                        id: coerceToArrayBuffer(c.id),
                        transports: ["hybrid"]
                    }));
                }

                // Also strip authenticatorAttachment in case it snuck in
                if (publicKey.authenticatorSelection) {
                    delete publicKey.authenticatorSelection.authenticatorAttachment;
                }

                // 3. Prompt user using browser's native cross-device (QR) authenticator dialog
                const assertion = await navigator.credentials.get({ publicKey });

                // 4. Encode assertion response back into the expected FIDO2 structure
                const assertionResponse = {
                    id: assertion.id,
                    rawId: coerceToBase64Url(assertion.rawId),
                    type: assertion.type,
                    response: {
                        authenticatorData: coerceToBase64Url(assertion.response.authenticatorData),
                        clientDataJSON: coerceToBase64Url(assertion.response.clientDataJSON),
                        signature: coerceToBase64Url(assertion.response.signature),
                        userHandle: assertion.response.userHandle ? coerceToBase64Url(assertion.response.userHandle) : null
                    }
                };

                if (btn) btn.textContent = "Verifying...";

                // 5. Send assertion back to standard verification endpoint
                const verifyRes = await fetch('/api/auth/login/verify', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        email: emailVal,
                        assertionResponse: assertionResponse
                    })
                });

                const verifyData = await verifyRes.json();

                if (verifyData.success) {
                    showToast("Cross-device login successful!", "success");
                    submitFinalLogin();
                } else {
                    showToast(verifyData.message || "Cross-device login verification failed.", "error");
                    if (btn) btn.innerHTML = '<i class="fas fa-fingerprint"></i> Sign In with Passkey';
                }

            } catch (err) {
                console.error("Cross-Device WebAuthn error", err);
                showToast("Cross-device authentication cancelled or failed: " + err.message, "error");

                // Report failure to backend for analytics
                fetch('/api/auth/login/report-failure', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: emailVal, errorMessage: err.message })
                }).catch(e => console.error("Failed to report error", e));

                if (btn) btn.innerHTML = '<i class="fas fa-fingerprint"></i> Sign In with Passkey';
            }
        }

        function toggleSimulator(visible) {
            const simulator = document.getElementById("mobile-simulator");
            if (visible) {
                simulator.classList.add("visible");
            } else {
                simulator.classList.remove("visible");
            }
        }

        function startCountdown() {
            countdownSeconds = 60;
            const bar = document.getElementById("timer-bar-fill");
            const label = document.getElementById("countdown-lbl");
            
            bar.style.width = "100%";
            label.textContent = `Expires in ${countdownSeconds} seconds`;
            label.style.color = "var(--text-secondary)";

            if (countdownInterval) clearInterval(countdownInterval);

            countdownInterval = setInterval(() => {
                countdownSeconds--;
                bar.style.width = (countdownSeconds / 60 * 100) + "%";
                label.textContent = `Expires in ${countdownSeconds} seconds`;

                if (countdownSeconds <= 15) {
                    label.style.color = "#ef4444";
                }

                if (countdownSeconds <= 0) {
                    clearInterval(countdownInterval);
                    showToast("QR code expired! Please request a new session.", "error");
                    resetLoginStage();
                }
            }, 1000);
        }

        function resetLoginStage() {
            if (countdownInterval) clearInterval(countdownInterval);
            document.getElementById("login-stage-2").style.display = "none";
            document.getElementById("login-stage-1").style.display = "block";
            toggleSimulator(false);
        }

        function simulateQrScan() {
            const btn = document.getElementById("scan-action-btn");
            const scanInstruction = document.getElementById("scanner-instruction-lbl");
            const viewport = document.querySelector(".scanner-viewport");
            
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing Scan...';
            scanInstruction.innerHTML = '<span style="color: var(--accent-color);">Analyzing QR Matrix...</span>';
            
            // Add flash animation effect to camera viewport
            viewport.style.background = "rgba(255, 255, 255, 0.4)";
            setTimeout(() => {
                viewport.style.background = "rgba(var(--accent-rgb), 0.05)";
            }, 150);

            setTimeout(() => {
                scanInstruction.innerHTML = '<span style="color: #10b981;"><i class="fas fa-check-circle"></i> Decrypted! Session key matched.</span>';
                
                setTimeout(() => {
                    btn.innerHTML = '<i class="fas fa-lock-open"></i> Session Authorized!';
                    btn.style.background = "#10b981";
                    btn.style.borderColor = "#10b981";
                    
                    showToast("MFA Approved! Logging in desktop session...", "success");

                    setTimeout(() => {
                        submitFinalLogin();
                    }, 1000);

                }, 1000);
            }, 1800);
        }

        function submitFinalLogin() {
            window.location.href = "/Portal/Dashboard";
        }
    </script>
</body>
</html>
