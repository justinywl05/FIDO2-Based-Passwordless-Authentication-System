@model IEnumerable<NexusUniversityWebPortal.AuthBackend.Models.Device>

@{
    ViewData["Title"] = "Device Management";
    Layout = "~/Views/Shared/_PortalLayout.cshtml";
}

<div class="page-title-area">
    <div>
        <h1 class="page-title"><i class="fas fa-laptop-medical" style="color: var(--accent-color); margin-right: 8px;"></i> Device Management</h1>
        <p class="page-subtitle">Inspect, approve, and revoke student and staff access devices.</p>
    </div>
</div>

<!-- Main Devices List -->
<div class="glass-panel" style="padding: 24px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
        <h3 class="card-title">Registered Access Devices</h3>
        <div style="position: relative; max-width: 260px;">
            <input class="form-input" id="device-search" placeholder="Search MAC or Owner..." style="padding: 8px 12px 8px 36px; font-size: 0.85rem;" oninput="filterDevices()" />
            <i class="fas fa-search" style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-size: 0.85rem;"></i>
        </div>
    </div>

    <div class="table-responsive">
        <table class="portal-table" id="devices-table">
            <thead>
                <tr>
                    <th>Device</th>
                    <th>Class</th>
                    <th>MAC Address</th>
                    <th>Owner</th>
                    <th>Registered At</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var device in Model)
                {
                    var statusClass = device.Status == "Approved" ? "status-success" : device.Status == "Pending Approval" ? "status-warning" : "status-danger";
                    var iconClass = device.DeviceType.ToLower() == "mobile" ? "fa-mobile-alt" : device.DeviceType.ToLower() == "tablet" ? "fa-tablet-alt" : "fa-laptop";
                    var bytes = device.DeviceId.ToByteArray();
                    var macAddress = string.Format("{0:X2}:{1:X2}:{2:X2}:{3:X2}:{4:X2}:{5:X2}", bytes[0], bytes[1], bytes[2], bytes[3], bytes[4], bytes[5]);
                    
                    <tr class="device-row" data-id="@device.DeviceId">
                        <td>
                            <div style="display: flex; align-items: center; gap: 12px;">
                                <i class="fas @iconClass" style="font-size: 1.5rem; color: var(--accent-color);"></i>
                                <div>
                                    <span style="font-weight: 600; display: block;">@device.DeviceName</span>
                                    <span style="font-size: 0.75rem; color: var(--text-muted);">ID: DEV-@device.DeviceId.ToString().Substring(0, 8)</span>
                                </div>
                            </div>
                        </td>
                        <td style="text-transform: capitalize;">@device.DeviceType</td>
                        <td><code>@macAddress</code></td>
                        <td>@(device.User != null ? $"{device.User.FullName} ({device.User.RoleId})" : "System / Unknown")</td>
                        <td>@device.RegisteredAt.ToString("MMM dd, yyyy")</td>
                        <td><span class="status-badge @statusClass">@device.Status</span></td>
                        <td>
                            <div style="display: flex; gap: 8px;">
                                @if (device.Status == "Pending Approval")
                                {
                                    <button class="btn-portal" style="padding: 6px 12px; font-size: 0.75rem;" onclick="approveDevice(this, '@device.DeviceId')">Approve</button>
                                    <button class="btn-portal-secondary" style="padding: 6px 12px; font-size: 0.75rem; color: #ef4444; border-color: rgba(239,68,68,0.2);" onclick="revokeDevice(this, '@device.DeviceId')">Reject</button>
                                }
                                else
                                {
                                    <button class="btn-portal-secondary" style="padding: 6px 12px; font-size: 0.75rem; color: #ef4444; border-color: rgba(239,68,68,0.2);" onclick="revokeDevice(this, '@device.DeviceId')">Revoke</button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Register Device -->
<div class="portal-modal" id="register-device-modal">
    <div class="modal-content glass-panel">
        <div class="modal-header">
            <h3 class="modal-title">Register Access Device</h3>
            <button class="modal-close" onclick="closeModal('register-device-modal')"><i class="fas fa-times"></i></button>
        </div>
        
        <form id="register-device-form" onsubmit="handleDeviceSubmission(event)">
            <div class="form-group">
                <label class="form-label" for="ModalDeviceType">Device Class</label>
                <select class="form-select" id="ModalDeviceType">
                    <option value="Laptop">Laptop / Desktop</option>
                    <option value="Mobile">Smart Phone</option>
                    <option value="Tablet">Tablet Computer</option>
                </select>
            </div>
            
            <div class="form-group">
                <label class="form-label" for="ModalDeviceName">Device Model Name</label>
                <input class="form-input" id="ModalDeviceName" placeholder="e.g. Dell XPS 15, Galaxy S24" required />
            </div>

            <div class="form-group">
                <label class="form-label" for="ModalMAC">MAC Hardware Address</label>
                <input class="form-input" id="ModalMAC" placeholder="e.g. AA:BB:CC:DD:EE:FF" required pattern="^([0-9A-Fa-f]{2}[:-]){5}([0-9A-Fa-f]{2})$" />
                <span style="font-size: 0.7rem; color: var(--text-secondary); margin-top: 4px; display: block;">Format: XX:XX:XX:XX:XX:XX</span>
            </div>

            <div class="form-group">
                <label class="form-label" for="ModalOwner">Owner Name Reference</label>
                <select class="form-select" id="ModalOwner">
                    @if (ViewBag.Users != null)
                    {
                        foreach (var user in ViewBag.Users)
                        {
                            <option value="@user.FullName">@user.FullName (@user.RoleId)</option>
                        }
                    }
                </select>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn-portal-secondary" onclick="closeModal('register-device-modal')">Cancel</button>
                <button type="submit" class="btn-portal">Register Device</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Approve device (calls backend mutation endpoint)
        function approveDevice(button, deviceId) {
            const formData = new FormData();
            formData.append("deviceId", deviceId);

            fetch("/Portal/ActionApproveDevice", {
                method: "POST",
                body: formData
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    const row = button.closest("tr");
                    const statusCell = row.querySelector("td:nth-child(6)");
                    statusCell.innerHTML = '<span class="status-badge status-success">Approved</span>';
                    showToast("Device connection approved", "success");
                    setTimeout(() => window.location.reload(), 1000);
                } else {
                    showToast("Error approving device", "error");
                }
            })
            .catch(err => console.error(err));
        }

        // Revoke device
        function revokeDevice(button, deviceId) {
            const formData = new FormData();
            formData.append("deviceId", deviceId);

            fetch("/Portal/ActionRevokeDevice", {
                method: "POST",
                body: formData
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    const row = button.closest("tr");
                    row.style.transform = "translateX(50px)";
                    row.style.opacity = "0";
                    row.style.transition = "all 0.3s ease";
                    
                    setTimeout(() => {
                        row.remove();
                        showToast("Device access revoked successfully!", "success");
                    }, 300);
                } else {
                    showToast("Error revoking device", "error");
                }
            })
            .catch(err => console.error(err));
        }

        // Search/Filter devices
        function filterDevices() {
            const query = document.getElementById("device-search").value.toLowerCase();
            const rows = document.querySelectorAll("#devices-table tbody tr");
            
            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                row.style.display = text.includes(query) ? "" : "none";
            });
        }

        // Handle form submission to register device
        function handleDeviceSubmission(e) {
            e.preventDefault();
            
            const type = document.getElementById("ModalDeviceType").value;
            const name = document.getElementById("ModalDeviceName").value;
            const mac = document.getElementById("ModalMAC").value.toUpperCase();
            const owner = document.getElementById("ModalOwner").value;

            const formData = new FormData();
            formData.append("deviceName", name);
            formData.append("deviceType", type);
            formData.append("mac", mac);
            formData.append("ownerName", owner);

            fetch("/Portal/ActionRegisterDevice", {
                method: "POST",
                body: formData
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    closeModal('register-device-modal');
                    document.getElementById("register-device-form").reset();
                    showToast("New device registered and approved!", "success");
                    
                    // Reload to display the strongly-typed row
                    setTimeout(() => {
                        window.location.reload();
                    }, 1000);
                } else {
                    showToast("Error registering device", "error");
                }
            })
            .catch(err => console.error(err));
        }
    </script>
}

