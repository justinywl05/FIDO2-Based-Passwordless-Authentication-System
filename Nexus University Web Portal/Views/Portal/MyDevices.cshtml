@model IEnumerable<NexusUniversityWebPortal.AuthBackend.Models.Device>

@{
    ViewData["Title"] = "My Devices";
    Layout = "~/Views/Shared/_PortalLayout.cshtml";
    var protectedId = ViewBag.ProtectedDeviceId as Guid?;
}

<div class="page-title-area">
    <div>
        <h1 class="page-title"><i class="fas fa-mobile-screen-button" style="color: var(--accent-color); margin-right: 8px;"></i> My Devices</h1>
        <p class="page-subtitle">Manage the FIDO2 passkey devices linked to your account. Your primary enrolled device is protected and cannot be removed.</p>
    </div>
    <div>
        <button class="btn-portal" style="padding: 8px 18px;" onclick="generateSelfQR()">
            <i class="fas fa-qrcode"></i> Add New Device
        </button>
    </div>
</div>

<div class="stat-grid" style="grid-template-columns: repeat(3, 1fr); margin-bottom: 24px;">
    <div class="stat-card glass-panel" style="padding: 16px 24px;">
        <div class="stat-info"><span class="stat-label">Total Devices</span><span class="stat-value">@Model.Count()</span></div>
        <div class="stat-icon"><i class="fas fa-laptop"></i></div>
    </div>
    <div class="stat-card glass-panel" style="padding: 16px 24px;">
        <div class="stat-info"><span class="stat-label">Active Devices</span><span class="stat-value" style="color:#10b981;">@Model.Count(d => d.Status == "Active")</span></div>
        <div class="stat-icon" style="color:#10b981;background:rgba(16,185,129,0.1);"><i class="fas fa-circle-check"></i></div>
    </div>
    <div class="stat-card glass-panel" style="padding: 16px 24px;">
        <div class="stat-info"><span class="stat-label">Root of Trust</span><span class="stat-value" style="color:#f59e0b;">1</span></div>
        <div class="stat-icon" style="color:#f59e0b;background:rgba(245,158,11,0.1);"><i class="fas fa-shield-halved"></i></div>
    </div>
</div>

<div class="glass-panel" style="padding: 24px;">
    <h3 class="card-title" style="margin-bottom: 20px;">Registered Passkey Devices</h3>
    <div class="table-responsive">
        <table class="portal-table">
            <thead>
                <tr><th>Device</th><th>Type</th><th>Registered</th><th>Last Used</th><th>Status</th><th>Action</th></tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="6" style="text-align:center;padding:32px;color:var(--text-muted);">
                        <i class="fas fa-laptop" style="font-size:2rem;display:block;margin-bottom:12px;opacity:0.3;"></i>No devices yet.
                    </td></tr>
                }
                @foreach (var device in Model)
                {
                    var isProt = protectedId.HasValue && device.DeviceId == protectedId.Value;
                    var icon = device.DeviceType.ToLower()=="mobile"?"fa-mobile-alt":device.DeviceType.ToLower()=="tablet"?"fa-tablet-alt":"fa-laptop";
                    var sc = device.Status == "Active" ? "status-success" : "status-danger";
                    <tr>
                        <td>
                            <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
                                <i class="fas @icon" style="font-size:1.4rem;color:var(--accent-color);"></i>
                                <div>
                                    <span style="font-weight:600;display:block;">@device.DeviceName</span>
                                    <span style="font-size:0.7rem;color:var(--text-muted);">ID: DEV-@device.DeviceId.ToString().Substring(0,8)</span>
                                </div>
                                @if (isProt) {
                                    <span style="font-size:0.65rem;font-weight:700;background:rgba(245,158,11,0.12);color:#f59e0b;border:1px solid rgba(245,158,11,0.3);border-radius:20px;padding:2px 8px;white-space:nowrap;">
                                        <i class="fas fa-shield-halved"></i> Protected
                                    </span>
                                }
                            </div>
                        </td>
                        <td style="text-transform:capitalize;">@device.DeviceType</td>
                        <td>@device.RegisteredAt.ToString("MMM dd, yyyy")</td>
                        <td>@(device.LastUsedAt.HasValue ? device.LastUsedAt.Value.ToString("MMM dd, yyyy") : "&#x2014;")</td>
                        <td><span class="status-badge @sc">@device.Status</span></td>
                        <td>
                            @if (isProt) {
                                <span style="font-size:0.75rem;color:#f59e0b;font-weight:600;"><i class="fas fa-lock"></i> Cannot Remove</span>
                            } else {
                                <button class="btn-portal-secondary" style="padding:6px 12px;font-size:0.75rem;color:#ef4444;border-color:rgba(239,68,68,0.2);"
                                        onclick="revokeOwnDevice(this,'@device.DeviceId','@device.DeviceName')">
                                    <i class="fas fa-trash-alt"></i> Remove
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Add Device Modal — QR Code Flow -->
<div class="portal-modal" id="add-device-modal">
    <div class="modal-content glass-panel" style="max-width:500px;">
        <div class="modal-header">
            <h3 class="modal-title"><i class="fas fa-qrcode" style="color:var(--accent-color);margin-right:8px;"></i> Link New Device</h3>
            <button class="modal-close" onclick="closeAddDeviceModal()"><i class="fas fa-times"></i></button>
        </div>

        <!-- Stage 1: Generating -->
        <div id="qr-generating-stage" style="text-align:center;padding:24px 0;">
            <div style="font-size:3rem;color:var(--accent-color);margin-bottom:16px;"><i class="fas fa-spinner fa-spin"></i></div>
            <p style="color:var(--text-secondary);">Generating your secure registration link...</p>
        </div>

        <!-- Stage 2: QR Ready -->
        <div id="qr-ready-stage" style="display:none;">
            <p style="font-size:0.88rem;color:var(--text-secondary);margin-bottom:16px;line-height:1.5;">
                Scan this QR code with your <strong>other device</strong> (phone, tablet, etc.).
                It opens a page where that device can register its biometric passkey to your account.
                Expires in <strong>5 minutes</strong>.
            </p>
            <div id="self-qrcode" style="display:flex;justify-content:center;margin:16px 0;"></div>
            <div style="background:rgba(0,0,0,0.2);border:1px solid var(--border-color);border-radius:8px;padding:10px 12px;margin-bottom:14px;font-family:monospace;font-size:0.75rem;word-break:break-all;color:var(--text-muted);">
                <span id="self-url-display" style="color:var(--accent-color);"></span>
            </div>
            <div style="background:rgba(0,0,0,0.2);border-radius:999px;height:8px;margin:12px 0 6px;overflow:hidden;">
                <div id="self-expiry-bar" style="height:100%;background:#10b981;border-radius:999px;transition:width 1s linear,background 0.5s;width:100%;"></div>
            </div>
            <div id="self-expiry-text" style="font-size:0.82rem;color:var(--text-secondary);text-align:center;">Expires in 5:00</div>
            <div class="modal-footer" style="margin-top:16px;">
                <button type="button" class="btn-portal-secondary" onclick="closeAddDeviceModal()">Close</button>
                <button type="button" class="btn-portal" onclick="generateSelfQR()">
                    <i class="fas fa-refresh"></i> Regenerate
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script>
    let selfCountdownTimer = null;

    async function generateSelfQR() {
        document.getElementById("self-qrcode").innerHTML = "";
        document.getElementById("qr-generating-stage").style.display = "block";
        document.getElementById("qr-ready-stage").style.display = "none";
        if (selfCountdownTimer) clearInterval(selfCountdownTimer);
        openModal('add-device-modal');

        try {
            const res = await fetch('/api/auth/register/initiate-self', { method: 'POST' });
            const data = await res.json();

            if (!res.ok || data.status !== 'ok') {
                showToast(data.errorMessage || 'Failed to generate QR code.', 'error');
                closeAddDeviceModal(); return;
            }

            const url = data.registrationUrl;
            document.getElementById('self-url-display').textContent = url;
            document.getElementById("qr-generating-stage").style.display = "none";
            document.getElementById("qr-ready-stage").style.display = "block";

            new QRCode(document.getElementById('self-qrcode'), {
                text: url, width: 220, height: 220,
                colorDark: '#000000', colorLight: '#ffffff',
                correctLevel: QRCode.CorrectLevel.H
            });

            setTimeout(() => {
                const el = document.querySelector('#self-qrcode img') || document.querySelector('#self-qrcode canvas');
                if (el) { el.style.borderRadius = '12px'; el.style.padding = '12px'; el.style.background = 'white'; }
            }, 50);

            const expiresAt = new Date(data.expiresAt).getTime();
            const totalMs = 5 * 60 * 1000;
            selfCountdownTimer = setInterval(() => {
                const remaining = Math.max(0, expiresAt - Date.now());
                const pct = (remaining / totalMs) * 100;
                const bar = document.getElementById('self-expiry-bar');
                bar.style.width = `${pct}%`;
                bar.style.background = pct > 40 ? '#10b981' : pct > 15 ? '#f59e0b' : '#ef4444';
                const secs = Math.floor(remaining / 1000);
                const m = Math.floor(secs / 60), s = (secs % 60).toString().padStart(2, '0');
                document.getElementById('self-expiry-text').textContent = remaining > 0
                    ? `Expires in ${m}:${s}` : 'Expired — click Regenerate';
                if (remaining === 0) { clearInterval(selfCountdownTimer); document.getElementById('self-qrcode').style.opacity = '0.3'; }
            }, 1000);

        } catch (err) {
            showToast('Network error: ' + err.message, 'error');
            closeAddDeviceModal();
        }
    }

    function closeAddDeviceModal() {
        if (selfCountdownTimer) clearInterval(selfCountdownTimer);
        closeModal('add-device-modal');
    }

    function revokeOwnDevice(btn, deviceId, deviceName) {
        if (!confirm(`Remove "${deviceName}"? Its passkey will be deleted.`)) return;
        const fd = new FormData(); fd.append("deviceId", deviceId);
        fetch("/Portal/ActionRevokeOwnDevice", { method:"POST", body:fd })
            .then(r=>r.json()).then(d=>{
                if(d.success){const row=btn.closest("tr");row.style.opacity="0";row.style.transform="translateX(40px)";row.style.transition="all 0.3s";setTimeout(()=>{row.remove();showToast(`"${deviceName}" removed.`,"success");},300);}
                else showToast(d.message||"Could not remove.","error");
            });
    }
</script>
}
